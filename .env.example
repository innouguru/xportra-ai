# Xportra AI — repository-authoritative environment template.
# Values below are placeholders only; never real secrets.
# Production safety (Phase 10.1): production deployments must set
# APP_ENV=production, APP_DEBUG=false (or unset), and provide real
# SUPABASE_JWT_SECRET and DATABASE_URL. The development tenant header
# (X-Development-Tenant-ID) is disabled when APP_ENV=production.
APP_ENV=development
APP_NAME=xportra-ai
APP_DEBUG=true

DATABASE_URL=

# Authentication (Supabase Auth)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOG_LEVEL=INFO
