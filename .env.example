# Xportra AI — repository-authoritative environment template.
# Values below are placeholders only; never real secrets.
# Production safety (Phase 10.1): production deployments must set
# APP_ENV=production, APP_DEBUG=false (or unset), and provide real
# SUPABASE_JWT_SECRET and DATABASE_URL. The development tenant header
# (X-Development-Tenant-ID) is disabled when APP_ENV=production.
APP_ENV=development
APP_NAME=xportra-ai
APP_DEBUG=true

DATABASE_URL=

# Authentication (Supabase Auth)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Evidence upload (Phase 10.4, private Supabase Storage).
# SUPABASE_SERVICE_ROLE_KEY authorizes server-side object
# puts and short-lived signed-URL issuance; it is never
# exposed to clients. EVIDENCE_STORAGE_BUCKET names the
# single private bucket (default: tenant-evidence).
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_STORAGE_BUCKET=tenant-evidence

VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOG_LEVEL=INFO
