# Xportra AI — repository-authoritative environment template.
# Values below are placeholders only; never real secrets.
# Production safety (Phase 10.1): production deployments must set
# APP_ENV=production, APP_DEBUG=false (or unset), and provide real
# SUPABASE_JWT_SECRET and DATABASE_URL. The development tenant header
# (X-Development-Tenant-ID) is disabled when APP_ENV=production.
# Render wiring: SUPABASE_URL is additionally required in production
# (pins token-issuer verification); the Render start command is
# `uvicorn xportra.api.app:app --host 0.0.0.0 --port $PORT`.
APP_ENV=development
APP_NAME=xportra-ai
APP_DEBUG=true

# CORS: explicit browser origins allowed to call the API.
# Development/test always permit the local Vite origins
# (http://localhost:5173 and http://127.0.0.1:5173);
# entries here are added to them. Production uses ONLY
# this variable and fails closed (no browser access)
# when it is empty; wildcards are rejected at startup.
# Comma-separated list, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=

DATABASE_URL=

# Authentication (Supabase Auth)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Evidence upload (Phase 10.4, private Supabase Storage).
# SUPABASE_SERVICE_ROLE_KEY authorizes server-side object
# puts and short-lived signed-URL issuance; it is never
# exposed to clients. EVIDENCE_STORAGE_BUCKET names the
# single private bucket (default: tenant-evidence).
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_STORAGE_BUCKET=tenant-evidence

VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=

# Qdrant Cloud authentication. Optional: set for key-mandated
# hosts (Qdrant Cloud Free Tier); leave empty for keyless
# deployments and local development (existing behavior).
# Never a real key in this file.
QDRANT_API_KEY=

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
LOG_LEVEL=INFO
